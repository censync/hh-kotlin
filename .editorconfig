# EditorConfig: https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.bat]
end_of_line = crlf

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Golden vectors are tab-separated and copied byte for byte from hh-cpp.
[testdata/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

# The hand-made cases of the differential test are bytes: trailing blanks, a CR and the missing final
# newline are cases.
[tools/edge-cases.txt]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
